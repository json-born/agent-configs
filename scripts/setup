#!/usr/bin/env bash
set -euo pipefail

# setup — Wire this repo into ~/.claude/ and ~/.agents/, and register skills as slash commands.
#
# For users keeping this repo outside ~/.claude/ (e.g. ~/code/agent-configs/).
# If you cloned directly to ~/.claude/, this script is not needed.
#
# Usage: ./scripts/setup

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE_DIR="$HOME/.claude"
AGENTS_DIR="${REPO_DIR}/.agents"

mkdir -p "$CLAUDE_DIR"
mkdir -p "$AGENTS_DIR"

link_target() {
  local target="$1"
  local link="$2"
  local label="${link/#$HOME/~}"

  if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
    echo "  $label already linked, skipping."
  elif [[ -L "$link" ]]; then
    read -rp "  $label is a symlink pointing elsewhere. Overwrite? [y/N] " confirm
    [[ "$confirm" == [yY] ]] || { echo "  Skipped."; return 0; }
    rm -f "$link"
    ln -s "$target" "$link"
    echo "  Linked: $label -> $target"
  elif [[ -e "$link" ]]; then
    read -rp "  $label exists and is not a symlink. Overwrite? [y/N] " confirm
    [[ "$confirm" == [yY] ]] || { echo "  Skipped."; return 0; }
    rm -rf "$link"
    ln -s "$target" "$link"
    echo "  Linked: $label -> $target"
  else
    ln -s "$target" "$link"
    echo "  Linked: $label -> $target"
  fi
}

echo "Setting up ~/.claude/ links..."
link_target "${REPO_DIR}/CLAUDE.md" "${CLAUDE_DIR}/CLAUDE.md"
link_target "${REPO_DIR}/rules" "${CLAUDE_DIR}/rules"

echo ""
echo "Setting up ~/.agents link..."
link_target "${AGENTS_DIR}" "$HOME/.agents"

echo ""
echo "Installing skills..."
cd "$REPO_DIR" && npx skills experimental_install

echo ""
echo "Wiring skills as slash commands..."
mkdir -p "${CLAUDE_DIR}/commands"
for skill_dir in "${AGENTS_DIR}/skills"/*/; do
  skill_name="$(basename "$skill_dir")"
  skill_file="${skill_dir}SKILL.md"
  [[ -f "$skill_file" ]] || continue
  link_target "$skill_file" "${CLAUDE_DIR}/commands/${skill_name}.md"
done

echo ""
echo "Done."
