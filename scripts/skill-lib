#!/usr/bin/env bash
# skill-lib — shared library for skill installer scripts.
# Source from a thin adapter that sets the required config vars. Do not execute directly.
#
# Required config vars (set by the calling script):
#   SKILL_REPO          e.g. "anthropics/skills"
#   SKILL_BRANCH        e.g. "main"
#   SKILL_BASE_PATH     e.g. "skills"
#   SKILL_STRUCTURE     "flat" (skills/<name>/SKILL.md) or "nested" (skills/<category>/<name>/SKILL.md)
#   SKILL_STRIP_FIELDS  space-separated frontmatter fields to remove on download (may be empty)

API_BASE="https://api.github.com/repos/${SKILL_REPO}/contents/${SKILL_BASE_PATH}"
AGENT_CONFIGS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMANDS_DIR="${AGENT_CONFIGS_DIR}/commands"

# List names of directory-type entries from a GitHub contents API URL.
_dir_names() {
  curl -sL "$1" | python3 -c "
import sys, json
for item in json.load(sys.stdin):
    if item.get('type') == 'dir':
        print(item['name'])
" 2>/dev/null
}

list_skills() {
  echo "Available skills from ${SKILL_REPO}:"
  echo ""

  if [[ "$SKILL_STRUCTURE" == "flat" ]]; then
    _dir_names "${API_BASE}?ref=${SKILL_BRANCH}" \
      | while read -r name; do echo "  $name"; done

  else
    while IFS= read -r category; do
      local skills
      skills=$(_dir_names "${API_BASE}/${category}?ref=${SKILL_BRANCH}")
      if [[ -n "$skills" ]]; then
        echo "  ${category}:"
        while IFS= read -r skill; do
          echo "    $skill"
        done <<< "$skills"
      fi
    done < <(_dir_names "${API_BASE}?ref=${SKILL_BRANCH}")
    echo ""
  fi
}

# Emit the download_url for a skill's SKILL.md file, or return 1 if not found.
_find_download_url() {
  local skill_name="$1"
  local file_info url

  if [[ "$SKILL_STRUCTURE" == "flat" ]]; then
    url="${API_BASE}/${skill_name}/SKILL.md?ref=${SKILL_BRANCH}"
    file_info=$(curl -sL "$url")
    if echo "$file_info" | grep -q '"message": "Not Found"'; then
      return 1
    fi
    echo "$file_info" | grep -o '"download_url": "[^"]*"' | sed 's/"download_url": "//;s/"//'

  else
    while IFS= read -r category; do
      url="${API_BASE}/${category}/${skill_name}/SKILL.md?ref=${SKILL_BRANCH}"
      file_info=$(curl -sL "$url")
      if ! echo "$file_info" | grep -q '"message": "Not Found"'; then
        echo "$file_info" | grep -o '"download_url": "[^"]*"' | sed 's/"download_url": "//;s/"//'
        return 0
      fi
    done < <(_dir_names "${API_BASE}?ref=${SKILL_BRANCH}")
    return 1
  fi
}

_do_download() {
  local skill_name="$1"
  local target_file="${COMMANDS_DIR}/${skill_name}.md"
  local download_url

  if ! download_url=$(_find_download_url "$skill_name") || [[ -z "$download_url" ]]; then
    echo "Error: Skill '${skill_name}' not found in ${SKILL_REPO}." >&2
    echo "Run '$(basename "${BASH_SOURCE[1]}") list' to see available skills." >&2
    return 1
  fi

  mkdir -p "$COMMANDS_DIR"

  local content
  content=$(curl -sL "$download_url")
  if [[ -n "$SKILL_STRIP_FIELDS" ]]; then
    for field in $SKILL_STRIP_FIELDS; do
      content=$(echo "$content" | sed "/^${field}:/d")
    done
  fi
  printf '%s\n' "$content" > "$target_file"

  echo "Done. '${skill_name}' saved to ${target_file}"
}

add_skill() {
  local skill_name="$1"
  echo "Installing '${skill_name}' from ${SKILL_REPO}..."

  if command -v claude &>/dev/null; then
    claude plugin marketplace add "$SKILL_REPO" 2>/dev/null || true
    if claude plugin install "${skill_name}" 2>/dev/null; then
      echo "Installed '${skill_name}' via Claude Code plugin system."
      return 0
    fi
    echo "Plugin system unavailable for this skill, falling back to direct download..."
    echo ""
  fi

  _do_download "$skill_name"
}

remove_skill() {
  local skill_name="$1"
  local target_file="${COMMANDS_DIR}/${skill_name}.md"

  if [[ -f "$target_file" ]]; then
    read -rp "Remove '${skill_name}'? [y/N] " confirm
    [[ "$confirm" == [yY] ]] || { echo "Aborted."; return 0; }
    rm -f "$target_file"
    echo "'${skill_name}' removed."
    return 0
  fi

  if command -v claude &>/dev/null; then
    if claude plugin list 2>/dev/null | grep -q "\"${skill_name}\""; then
      read -rp "Remove '${skill_name}' plugin? [y/N] " confirm
      [[ "$confirm" == [yY] ]] || { echo "Aborted."; return 0; }
      claude plugin uninstall "${skill_name}" -y
      echo "'${skill_name}' removed."
      return 0
    fi
  fi

  echo "No skill '${skill_name}' found." >&2
  return 1
}

skill_main() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: $(basename "${BASH_SOURCE[1]}") <command> [args]" >&2
    echo "Commands: list, add, remove" >&2
    exit 1
  fi

  case "$1" in
    add)
      [[ $# -ge 2 ]] || { echo "Usage: $(basename "${BASH_SOURCE[1]}") add <skill-name>" >&2; exit 1; }
      add_skill "$2"
      ;;
    remove|rm)
      [[ $# -ge 2 ]] || { echo "Usage: $(basename "${BASH_SOURCE[1]}") remove <skill-name>" >&2; exit 1; }
      remove_skill "$2"
      ;;
    list)
      list_skills
      ;;
    help|--help|-h)
      echo "Usage: $(basename "${BASH_SOURCE[1]}") <command> [args]"
      echo ""
      echo "Manage skills from ${SKILL_REPO}."
      echo ""
      echo "Commands:"
      echo "  list           List available skills"
      echo "  add <name>     Install or update a skill"
      echo "  remove <name>  Remove a skill"
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      echo "Unknown command: $1" >&2
      echo "Run '$(basename "${BASH_SOURCE[1]}") help' for usage." >&2
      exit 1
      ;;
  esac
}
