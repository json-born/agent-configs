#!/usr/bin/env bash
set -euo pipefail

# matt-skill — install commands from the Matt Pocock skills repo.
#
# Usage:
#   matt-skill list
#   matt-skill add <skill-name>
#   matt-skill remove <skill-name>

SKILL_REPO="mattpocock/skills"
SKILL_BRANCH="main"
SKILL_BASE_PATH="skills"
SKILL_STRUCTURE="nested"
SKILL_STRIP_FIELDS=""

# shellcheck source=skill-lib
source "$(dirname "$0")/../skill-lib"
skill_main "$@"
