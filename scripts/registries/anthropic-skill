#!/usr/bin/env bash
set -euo pipefail

# anthropic-skill — install commands from the Anthropic skills repo.
#
# Usage:
#   anthropic-skill list
#   anthropic-skill add <skill-name>
#   anthropic-skill remove <skill-name>

SKILL_REPO="anthropics/skills"
SKILL_BRANCH="main"
SKILL_BASE_PATH="skills"
SKILL_STRUCTURE="flat"
SKILL_STRIP_FIELDS="license"

# shellcheck source=skill-lib
source "$(dirname "$0")/../skill-lib"
skill_main "$@"
